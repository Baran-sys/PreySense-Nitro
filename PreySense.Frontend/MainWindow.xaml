<?xml version="1.0" encoding="utf-8"?>
<Window Style="{DynamicResource AppWindowRenderingStyle}" x:Class="PreySense.Frontend.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:PreySense.Frontend.ViewModels" xmlns:controls="clr-namespace:PreySense.Frontend.Controls" xmlns:local="clr-namespace:PreySense.Frontend" Title="PreySense" Icon="appicon.ico" Width="455" SizeToContent="Height" WindowStartupLocation="CenterScreen" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource AppFontFamily}" ResizeMode="NoResize" ShowInTaskbar="False">
  <Border Style="{DynamicResource AppWindowShellStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <controls:WindowTitleBar xmlns:services="clr-namespace:PreySense.Frontend.Services" Grid.Row="0" Subtitle="{x:Static services:UpdateCheckService.DisplayVersion}">
        <controls:WindowTitleBar.Actions>
          <Button AutomationProperties.AutomationId="BtnSettings" Style="{StaticResource TitleBarButtonStyle}" Click="SettingsButton_Click"
                  ToolTip="Open application settings, language, theme, and power preferences.">
            <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-settings-32.png" Width="14" Height="14" />
          </Button>
        </controls:WindowTitleBar.Actions>
      </controls:WindowTitleBar>
      <StackPanel Grid.Row="1" Margin="{StaticResource WindowContentMargin}">
        <Border Style="{StaticResource OriginalSectionPanelStyle}">
          <StackPanel>
            <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-gauge-32.png" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Performance Mode" Style="{StaticResource OriginalSectionTitleStyle}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Style="{StaticResource OriginalStatusTextStyle}"
                         VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                <Run Text="CPU"/><Run Text=": "/>
                <Run Text="{Binding CpuTemperatureText, Mode=OneWay}"/>
                <Run Text=" • "/>
                <Run Text="{Binding CpuFanText, Mode=OneWay}"/>
              </TextBlock>
            </Grid>
            <UniformGrid Columns="5" Rows="1" Margin="0,2,0,2">
              <Button AutomationProperties.AutomationId="BtnModeEco" Command="{Binding SetModeCommand}" CommandParameter="6"
                      ToolTip="Maximum battery savings with minimal power limits and quiet fan behavior.">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonTileStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsEcoActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource ModeEcoBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{x:Static local:ModeIconData.EcoGeometry}" Fill="{DynamicResource IconForegroundBrush}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,0,5" />
                  <TextBlock FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" Text="Eco" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.AutomationId="BtnModeQuiet" Command="{Binding SetModeCommand}" CommandParameter="0"
                      ToolTip="Low-noise profile with moderate performance and restrained fan speeds.">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonTileStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsQuietActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource ModeQuietBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{x:Static local:ModeIconData.QuietGeometry}" Fill="{DynamicResource IconForegroundBrush}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,0,5" />
                  <TextBlock Text="Quiet" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.AutomationId="BtnModeBalanced" CommandParameter="1" Command="{Binding SetModeCommand}"
                      ToolTip="Everyday balanced profile optimizing efficiency, acoustics, and responsiveness.">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonTileStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsBalancedActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{x:Static local:ModeIconData.BalancedGeometry}" Fill="{DynamicResource IconForegroundBrush}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,0,5" />
                  <TextBlock Text="Balanced" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.AutomationId="BtnModePerformance" CommandParameter="4" Command="{Binding SetModeCommand}"
                      ToolTip="High CPU/GPU power limits and faster fan response for demanding workloads and gaming.">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonTileStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsPerformActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource ModePerformanceBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{x:Static local:ModeIconData.PerformanceGeometry}" Fill="{DynamicResource IconForegroundBrush}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,0,5" />
                  <TextBlock Text="Performance" FontSize="{DynamicResource FontSizeTile}" TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button AutomationProperties.AutomationId="BtnModeTurbo" CommandParameter="5" Command="{Binding SetModeCommand}"
                      ToolTip="Maximum power delivery and aggressive cooling for peak gaming and rendering performance.">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonTileStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsTurboActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource ModeTurboBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{x:Static local:ModeIconData.TurboGeometry}" Fill="{DynamicResource IconForegroundBrush}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,0,5" />
                  <TextBlock Text="Turbo" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </UniformGrid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="{StaticResource StandardSectionMargin}">
          <StackPanel>
            <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-video-card-32.png" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="GPU Mode" Style="{StaticResource OriginalSectionTitleStyle}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Style="{StaticResource OriginalStatusTextStyle}"
                         VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                <Run Text="GPU"/><Run Text=": "/>
                <Run Text="{Binding GpuTemperatureText, Mode=OneWay}"/>
                <Run Text=" • "/>
                <Run Text="{Binding GpuFanText, Mode=OneWay}"/>
              </TextBlock>
            </Grid>
            <UniformGrid Columns="{Binding GpuModeTileColumns}" Rows="1" Margin="0,2,0,2">
              <Button Height="52" Margin="2.5" CommandParameter="1" Command="{Binding SetGpuMuxModeCommand}"
                      ToolTip="NVIDIA Dynamic Display Switch: uses iGPU on desktop for efficiency and switches live to NVIDIA GPU during 3D loads without reboot.">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonActionStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsGpuAutoActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-automation-32.png" Width="20" Height="20" Margin="0,0,0,2" />
                  <TextBlock Text="Auto" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Height="52" Margin="2.5" CommandParameter="igpu" Command="{Binding SetGpuMuxModeCommand}" Visibility="{Binding ShowIgpuOnlyTile, Converter={StaticResource BoolToVis}}"
                      ToolTip="Run strictly on the integrated GPU and disable the discrete NVIDIA GPU in Windows for maximum battery life.">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonActionStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsGpuIgpuOnlyActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-video-48.png" Width="20" Height="20" Margin="0,0,0,2" />
                  <TextBlock Text="iGPU Only" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Height="52" Margin="2.5" CommandParameter="0" Command="{Binding SetGpuMuxModeCommand}" Visibility="{Binding ShowDdsGpuTiles, Converter={StaticResource BoolToVis}}"
                      ToolTip="Optimus mode: integrated GPU always drives the display while the NVIDIA GPU sleeps when idle or renders 3D apps through iGPU.">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonActionStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsGpuOptimusActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{x:Static local:ModeIconData.HybridGpuGeometry}"
                        Stroke="{DynamicResource IconForegroundBrush}"
                        StrokeThickness="1.8"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        Fill="Transparent"
                        Width="20"
                        Height="20"
                        Stretch="Uniform"
                        Margin="0,0,0,2" />
                  <TextBlock Text="Hybrid" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Height="52" Margin="2.5" CommandParameter="2" Command="{Binding SetGpuMuxModeCommand}" Visibility="{Binding ShowAdvancedOptimusTile, Converter={StaticResource BoolToVis}}"
                      ToolTip="Connect the internal display directly to the NVIDIA GPU via DDS without rebooting for lowest latency and highest FPS.">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonActionStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsGpuAdvancedOptimusActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource ModePerformanceBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-game-controller-48.png" Width="20" Height="20" Margin="0,0,0,2" />
                  <TextBlock Text="Advanced Optimus" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </Button>
              <Button Height="52" Margin="2.5" Command="{Binding SetBiosDiscreteGpuCommand}" Visibility="{Binding ShowDgpuOnlyTile, Converter={StaticResource BoolToVis}}"
                      ToolTip="Switch the firmware MUX exclusively to the discrete NVIDIA GPU and bypass iGPU (requires restart).">
                <Button.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonActionStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsBiosDiscreteGpuActive}">
                        <Setter Property="BorderBrush" Value="{DynamicResource ModePerformanceBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-video-card-32.png" Width="20" Height="20" Margin="0,0,0,2" />
                  <TextBlock Text="dGPU Only" FontSize="{DynamicResource FontSizeTile}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </Button>
            </UniformGrid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource OriginalSectionPanelStyle}" Margin="{StaticResource StandardSectionMargin}">
          <StackPanel>
            <Grid Style="{StaticResource OriginalSectionTitlePanelStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-laptop-32.png" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Display" Style="{StaticResource OriginalSectionTitleStyle}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding ActiveGpuDisplayMode, Mode=OneWay}"
                         Style="{StaticResource OriginalStatusTextStyle}" HorizontalAlignment="Right"
                         VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <Grid Margin="0,2,0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>

              <Button Grid.Column="0" Height="32" HorizontalAlignment="Stretch" Margin="2.5,0,5,0" Command="{Binding ToggleAutoRefreshRateCommand}"
                      ToolTip="Automatically drop the display refresh rate to 60 Hz on battery and restore full Hz on AC.">
                <FrameworkElement.Style>
                  <Style BasedOn="{StaticResource OriginalRButtonActionStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsAutoRefreshRateEnabled}">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{DynamicResource SelectedTileGradientBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <TextBlock Text="Auto" FontSize="{DynamicResource FontSizeTile}" />
              </Button>

              <ComboBox Grid.Column="1" Height="32" Margin="0,0,2.5,0"
                        ToolTip="Manually choose the active panel refresh rate."
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Padding="20,2"
                        FontSize="{DynamicResource FontSizeTile}"
                        ItemsSource="{Binding AvailableRefreshRates}"
                        SelectedItem="{Binding SelectedRefreshRateOption, Mode=TwoWay}"/>
            </Grid>
          </StackPanel>
        </Border>

      </StackPanel>
      <Grid Grid.Row="2" Margin="{StaticResource WindowFooterMargin}">
        <Grid.RowDefinitions>
          <RowDefinition Height="29"/>
          <RowDefinition Height="4"/>
          <RowDefinition Height="29"/>
        </Grid.RowDefinitions>
        <UniformGrid Grid.Row="0" Columns="3" HorizontalAlignment="Stretch">
          <Button AutomationProperties.AutomationId="BtnNavLighting" Style="{StaticResource WindowFooterButtonStyle}" Click="KeyboardButton_Click"
                  ToolTip="Customize keyboard zones, dynamic effects, and lid logo lighting.">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-color-32.png" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock Text="Lighting" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.AutomationId="BtnNavMetrics" Style="{StaticResource WindowFooterButtonStyle}" Click="MetricsButton_Click"
                  ToolTip="Configure the in-game hardware monitoring HUD overlay and metric slots.">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-soonvibes-32.png" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock Text="Overlay" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.AutomationId="BtnNavFans" Style="{StaticResource WindowFooterButtonStyle}" Click="FansButton_Click"
                  ToolTip="Calibrate fans, edit custom RPM curves, and tune ramp/hysteresis behavior.">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-fan-32.png" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock Text="Fans" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </UniformGrid>
        <UniformGrid Grid.Row="2" Columns="2" HorizontalAlignment="Stretch">
          <Button AutomationProperties.AutomationId="BtnNavMode" Style="{StaticResource WindowFooterButtonStyle}" Click="ModeSettingsButton_Click"
                  ToolTip="Tune CPU boost, power limits (PL1/PL2), PROCHOT, Smart Boost, and GPU clocks/power.">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-processor-32.png" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock Text="Tuning" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button AutomationProperties.AutomationId="BtnNavQuit" Style="{StaticResource WindowFooterButtonStyle}" Click="QuitButton_Click"
                  ToolTip="Close PreySense completely and restore default GPU clocks.">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <controls:ThemedIcon Source="pack://application:,,,/Resources/icons8-quit-32.png" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
              <TextBlock Text="Quit" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </UniformGrid>
      </Grid>
    </Grid>
  </Border>
</Window>
